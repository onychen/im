      },
      {
        "id": "offline-sync",
        "label": "离线成员拉取",
        "focus": ["offline-member", "gateway", "redis"],
        "note": "离线成员重新上线后通过 syncReq 拉取共享发件箱补齐消息。"
      }
    ]
  },
