  "cards": [
    {
      "dot": "cyan",
      "title": "主链路",
      "items": [
        "上行帧经网关进入单次 Lua 原子写入，无中间态",
        "消息 ID 由 Redis TIME 毫秒+毫内序号生成，毫内最多 999 条"
      ]
    },
    {
      "dot": "amber",
      "title": "Stream 中继",
      "items": [
        "事件先入 Redis Stream，relay 中继到 Kafka 后才 XACK/XDEL",
        "投递失败超 30 分钟的事件移入失败待办，由重放循环持续补偿"
      ]
    },
    {
      "dot": "emerald",
      "title": "异步持久化",
      "items": [
        "消费者只负责幂等落库，不再承担收发箱与未读写入",
        "失败转 retry Topic 延迟回流，重试 5 次后进入 DLQ 隔离"
      ]
    }
  ]
